APP_NAME="LWTV PWA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8069
APP_PORT=8069

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/data/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LezWatch.TV API. For local development against the Local site use:
#   LWTV_API_URL=https://lwtv.local
#   LWTV_API_VERIFY_TLS=false
LWTV_API_URL=https://lezwatchtv.com
LWTV_API_VERIFY_TLS=true
LWTV_API_TIMEOUT=30

# Staff admin (sync log and Sync now). Off while ADMIN_PATH is empty.
# ADMIN_PATH is the secret path the admin lives under, e.g. a long random
# string. It keeps scanners out; Google sign-in and the group check are the lock.
ADMIN_PATH=
ADMIN_GROUP=pwa-admins@lezwatchtv.com
# How often a signed-in admin's group membership is checked again (minutes).
ADMIN_RECHECK_MINUTES=1440
GOOGLE_WORKSPACE_DOMAIN=lezwatchtv.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The service account's JSON key, as seen inside the container. Put the file
# at secrets/google-service-account.json next to compose.yaml.
GOOGLE_SERVICE_ACCOUNT_KEY=/run/secrets/google-service-account.json

# Proxies whose X-Forwarded-* headers are believed. Defaults to private
# ranges (Docker's bridge gateway). Never "*". See config/trustedproxy.php.
# TRUSTED_PROXIES=172.16.0.0/12
